#!/usr/bin/env bash
# Keep this fork synced with upstream (zed-industries/zed).
#
# Model: main carries all custom commits linearly on top of upstream/main.
# Syncing replays those commits onto a captured upstream commit.
#
# Fully automated: fast-forwards and clean rebases push directly.
# On rebase conflict the script resolves with opencode headlessly
# (Claude Sonnet 5.5 through the GitHub Copilot provider, xhigh reasoning)
# then verifies before pushing.
# CI (fork-sync.yml) resolves the same way, but inside a Namespace Devbox:
# the resolution runs there (script/fork-resolve) and the result is
# verified by fork-checks before it is pushed to main.
#
# Usage:
#   script/fork-sync [--dry-run] [--no-push] [--no-ai] [--skip-verify]
#                    [--upstream <remote>] [--model <m>] [--variant <v>]
#
#   --dry-run         print the plan (how far each branch trails) and exit
#                     before moving anything
#   --no-push         leave the rebased branch local (no pushes)
#   --no-ai           don't call opencode; abort on conflict for manual fix
#   --skip-verify     skip ./script/fork-checks after a rebase (pushed main
#                     gets no CI run -- this is the only gate, so skipping is
#                     at your own risk)
#   --upstream <name> upstream remote name (default: upstream)
#   --model <m>       opencode model (default: github-copilot/claude-sonnet-5.5)
#   --variant <v>     model reasoning variant (default: xhigh)

set -euo pipefail

cd "$(dirname "$0")/.." || exit 1

DRY_RUN=false
PUSH=true
AI=true
SKIP_VERIFY=false
UPSTREAM="upstream"
MODEL="github-copilot/claude-sonnet-5.5"
VARIANT="xhigh"

while [ "$#" -gt 0 ]; do
    case "$1" in
        --dry-run)
            DRY_RUN=true
            shift
            ;;
        --no-push)
            PUSH=false
            shift
            ;;
        --no-ai)
            AI=false
            shift
            ;;
        --skip-verify)
            SKIP_VERIFY=true
            shift
            ;;
        --upstream)
            UPSTREAM="$2"
            shift 2
            ;;
        --model)
            MODEL="$2"
            shift 2
            ;;
        --variant)
            VARIANT="$2"
            shift 2
            ;;
        -h | --help)
            echo "Usage: script/fork-sync [--dry-run] [--no-push] [--no-ai] [--skip-verify] [--upstream <remote>] [--model <m>] [--variant <v>]"
            exit 0
            ;;
        *)
            echo "Unknown argument: $1 (see --help)" >&2
            exit 1
            ;;
    esac
done

if ! git diff --quiet || ! git diff --cached --quiet; then
    echo "error: working tree is dirty -- commit or stash first" >&2
    exit 1
fi

if ! git remote get-url "$UPSTREAM" >/dev/null 2>&1; then
    echo "error: no '$UPSTREAM' remote -- add it with:" >&2
    echo "  git remote add upstream https://github.com/zed-industries/zed.git" >&2
    exit 1
fi

command -v gh >/dev/null 2>&1 || {
    echo "error: gh CLI required (push + checks dispatch)" >&2
    exit 1
}

git fetch "$UPSTREAM"
git fetch origin

if ! git show-ref --verify --quiet refs/heads/main; then
    echo "error: no local main branch" >&2
    exit 1
fi

SOURCE=$(git rev-parse --verify 'refs/remotes/origin/main^{commit}')
UPSTREAM_SHA=$(git rev-parse --verify "refs/remotes/$UPSTREAM/main^{commit}")
LOCAL_SHA=$(git rev-parse --verify 'refs/heads/main^{commit}')
if [ "$SOURCE" != "$LOCAL_SHA" ]; then
    echo "error: local main differs from origin/main -- reconcile it before syncing" >&2
    exit 1
fi
BASE=$(git merge-base "$SOURCE" "$UPSTREAM_SHA")
if [ -n "$(git rev-list --merges "$BASE..$SOURCE")" ]; then
    echo "error: main contains merge commits -- the fork's history must be linear" >&2
    exit 1
fi
BEHIND=$(git rev-list --count "$SOURCE..$UPSTREAM_SHA")
COMMITS=$(git rev-list --count "$BASE..$SOURCE")
echo "main has $COMMITS fork commit(s) and is $BEHIND behind $UPSTREAM/main"

if [ "$BEHIND" -eq 0 ]; then
    echo "Already up to date -- nothing to do."
    exit 0
fi
if [ "$DRY_RUN" = true ]; then
    echo "Would rebase $COMMITS main commit(s) onto $UPSTREAM_SHA."
    echo "--dry-run: not moving anything."
    exit 0
fi

git checkout -q main
if [ "$AI" = false ]; then
    if ! git rebase --onto "$UPSTREAM_SHA" "$BASE"; then
        git rebase --abort
        echo "Aborted (--no-ai). Resolve manually before pushing." >&2
        exit 1
    fi
else
    command -v opencode >/dev/null 2>&1 || {
        echo "error: opencode CLI not found -- install it or re-run with --no-ai" >&2
        exit 1
    }
    script/fork-resolve --onto "$UPSTREAM_SHA" --upstream-point "$BASE" --model "$MODEL" --variant "$VARIANT"
fi

git diff --check
if [ "$SKIP_VERIFY" = false ]; then
    ./script/fork-checks
fi
if [ "$PUSH" = false ]; then
    echo "Synced locally (--no-push). Push when ready with an explicit lease for $SOURCE."
    exit 0
fi

git push --force-with-lease="refs/heads/main:$SOURCE" origin main
echo "Synced main: $(git rev-parse --short main)"
echo "Dispatch fork-checks on main if you skipped verification:"
echo "  gh workflow run fork-checks.yml --repo somtooo/Endo --ref main"
